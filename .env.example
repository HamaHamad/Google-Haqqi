# GEMINI_API_KEY: Required for Gemini AI API calls (intake chat, general chat, drafts).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional: override the Gemini model used by the AI endpoints (default: gemini-2.5-flash)
# GEMINI_MODEL="gemini-2.5-flash"

# Optional: port the Express server listens on (default: 3000)
# PORT=3000

# Optional: directory where the JSON data store and uploaded evidence files are kept (default: ./data)
# DATA_DIR=./data

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
